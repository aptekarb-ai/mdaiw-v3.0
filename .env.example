# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Default local development database (SQLite, no server required):
DATABASE_URL=sqlite:///db.sqlite3
# Optional future PostgreSQL example (not activated for Module-1 Checkpoint 2):
# DATABASE_URL=postgresql://mdaiw_user:change_me@localhost:5432/mdaiw

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Face Recognition
# Comma-separated Fernet keys. The first key encrypts new embeddings; every
# listed key may decrypt existing ones (rotate by prepending a new key and
# keeping the old one until every credential has been re-enrolled).
# Generate one with:
#   backend\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_EMBEDDING_ENCRYPTION_KEYS=

# Which biometric engine new enrollments use — 'opencv_sface' (OpenCV
# YuNet detection + SFace embeddings, the default; run
# `manage.py download_face_models` first) or 'deepface' (the legacy
# RetinaFace/Facenet512 pipeline below, kept for rollback/compatibility).
# An existing FaceCredential always verifies through the engine recorded
# on it, never through this live setting — see backend/README.md's "Face
# recognition engine architecture".
FACE_RECOGNITION_ENGINE=opencv_sface
# Passive anti-spoofing is independent of which engine above is selected
# (YuNet+SFace has no anti-spoofing of its own). 'silent_face' wraps the
# project's existing Fasnet-based passive anti-spoofing model.
FACE_ANTI_SPOOF_PROVIDER=silent_face
# OpenCV Zoo's own documented default for SFace (models/
# face_recognition_sface/sface.py's _threshold_cosine) — a sourced
# starting point, not a production-calibrated value. Recalibrate against
# this project's own real-environment data before production use.
FACE_SFACE_COSINE_THRESHOLD=0.363
# YuNet's own documented/demo default minimum detection confidence.
FACE_MIN_DETECTION_CONFIDENCE=0.6
# Minimum face bounding-box width/height in pixels at the ~640x480
# capture resolution this project requests.
FACE_MIN_FACE_SIZE_PIXELS=60

FACE_MODEL_NAME=Facenet512
FACE_DETECTOR_BACKEND=retinaface
FACE_DISTANCE_METRIC=cosine
FACE_MAX_FAILED_ATTEMPTS=5
FACE_FAILURE_WINDOW_MINUTES=15
FACE_LOCK_MINUTES=30
FACE_CHALLENGE_TTL_SECONDS=120
FACE_ENROLLMENT_TOKEN_TTL_SECONDS=900
FACE_MAX_FRAMES=4
# Of the submitted (fully validated) frames, only this many highest-quality
# ones are actually spent on the embedding model — see
# faceauth/service.py::process_enrollment_frames. Minimum 2 (needed for
# cross-frame identity consistency).
FACE_EMBEDDING_FRAME_COUNT=2
FACE_FRAME_MAX_BYTES=2097152
FACE_ENROLLMENT_RESUME_MAX_ATTEMPTS=5
FACE_ENROLLMENT_RESUME_WINDOW_MINUTES=15
# Throttling for the final atomic registration submission and for issuing the
# anonymous, pre-account ENROLL challenge used by the inline registration
# wizard's Face Enrollment step (Step 3).
REGISTRATION_MAX_ATTEMPTS=10
REGISTRATION_WINDOW_MINUTES=60
FACE_ENROLLMENT_CHALLENGE_MAX_ATTEMPTS=10
FACE_ENROLLMENT_CHALLENGE_WINDOW_MINUTES=15
# Step 3 validates captured frames immediately and gets back a single-use
# proof (referencing the already-encrypted embedding) that must survive
# Step 4 review before final atomic registration consumes it.
FACE_ENROLLMENT_PROOF_TTL_SECONDS=900
FACE_ENROLLMENT_PROOF_MAX_ATTEMPTS=10
FACE_ENROLLMENT_PROOF_WINDOW_MINUTES=15
# Hard budget (seconds) for the synchronous biometric-processing call in
# enrollment-proof requests, once models are confirmed loaded in this
# process (the Django dev server now warms models automatically in the
# background on startup — see faceauth/apps.py — and a request fails fast
# with MODEL_UNAVAILABLE rather than waiting if they are not ready yet; for
# a deployed/production process, still run
# `python manage.py warm_up_face_models` at deploy time). Keep
# frontend/.env.example's VITE_FACE_PROCESSING_TIMEOUT_MS higher than this
# value (in milliseconds, with a safety margin) so the backend's own,
# distinguishable timeout response is what normally fires.
FACE_PROCESSING_TIMEOUT_SECONDS=120
# retina-face==0.0.18's model-construction code is incompatible with
# TensorFlow 2.21's default Keras 3 backend (raises "A KerasTensor cannot be
# used as input to a TensorFlow function" while building the detector).
# Setting this routes tf.keras through the installed tf-keras (Keras 2
# compatible) implementation instead, which resolves it. Already defaulted
# in backend/mdaiw/settings.py — only set here if you need to override it.
# TF_USE_LEGACY_KERAS=1

# Frontend
FRONTEND_URL=http://localhost:5173

# Yukti
YUKTI_VOICE_ENABLED=true
YUKTI_SPEECH_LANGUAGE=en-IN

# Yukti AI provider (optional). Leave YUKTI_AI_PROVIDER empty (default) to
# run the deterministic rule-based router only — no external calls, no key
# required. Set YUKTI_AI_PROVIDER=openai and provide OPENAI_API_KEY to
# enable conversational, multilingual answers backed by OpenAI structured
# outputs; the deterministic router remains the automatic fallback whenever
# the AI provider is unset, unavailable, rate-limited, or times out.
YUKTI_AI_PROVIDER=
YUKTI_AI_MODEL=gpt-4o-mini
YUKTI_AI_TIMEOUT_SECONDS=8
YUKTI_AI_MAX_OUTPUT_TOKENS=400
YUKTI_AI_MAX_REQUESTS_PER_WINDOW=20
YUKTI_AI_WINDOW_SECONDS=60
# Server-side only — never exposed to frontend JavaScript. Leave blank here;
# set a real value only in a local, uncommitted .env file.
OPENAI_API_KEY=
