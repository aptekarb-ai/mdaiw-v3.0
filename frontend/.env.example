# Base URL of the Django backend API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# How long (milliseconds) the browser waits for a Face Enrollment
# validation response (POST /api/v1/auth/face/enrollment-proof/) before
# giving up client-side. Must stay higher than the backend's own
# FACE_PROCESSING_TIMEOUT_SECONDS (see root .env.example), with a safety
# margin, so the backend's own timeout response — distinguishable from a
# client-side abort — is what normally fires. Default here (135000ms)
# matches the backend's default of 120s plus a 15s margin.
VITE_FACE_PROCESSING_TIMEOUT_MS=135000
